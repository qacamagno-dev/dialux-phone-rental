# ============================================================
# DiaLux – Backend environment template
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows cmd)
#     Copy-Item .env.example .env   (PowerShell)
#
# `.env` is gitignored and must NEVER be committed.
# ============================================================

# ---------------- required ----------------

# Port the Express server listens on.
PORT=5000

# MongoDB connection string.
# Atlas > Database > Connect > Drivers. Replace <db_password> with the
# database user's password and append the database name before the "?".
# With docker-compose this is set for you to mongodb://mongo:27017/dialux
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/dialux?retryWrites=true&w=majority

# Secret used to sign JWTs. Use a long random string — not a word.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---------------- deployment ----------------

# Set to "production" on any deployed instance.
#
# IMPORTANT: outside production the password-reset endpoint returns the reset
# link in its own JSON response, so the flow can be tested on a laptop with no
# mail server. On a public host that would be an account-takeover vector, so
# ALWAYS set this to production before exposing the app.
NODE_ENV=development

# Public base URL, used to build links inside emails. No trailing slash.
APP_URL=http://localhost:5000

# ---------------- optional ----------------

# Google OAuth client ID for "Sign in with Google".
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# This value is public by design (the browser sees it) — the client *secret* is
# what must stay private, and this app does not need it.
# Must match the <meta name="google-client-id"> in the frontend HTML.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Real email delivery. Both of these are optional and OFF by default:
# with no SMTP_URL, services/mailer.js writes every message to the server log
# and reports `emailed: false` rather than pretending it sent something.
#
# To switch on real delivery:
#   1. cd phone-rental-backend && npm i nodemailer
#   2. set SMTP_URL below
#
# Examples:
#   SMTP_URL=smtps://user:pass@smtp.gmail.com:465
#   SMTP_URL=smtp://user:pass@smtp.mailtrap.io:2525
SMTP_URL=
MAIL_FROM=DiaLux <no-reply@dialux.test>
